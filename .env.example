# sagex — root env (single source of truth for compose + Rust server).
# Copy to `.env` and adjust secrets. Real environment variables always win.
HOST=127.0.0.1
PORT=8080

# MongoDB (docker-compose service `mongodb`, database `sagexcadb`)
MONGO_ROOT_USER=sagexca
MONGO_ROOT_PASSWORD=change-me-in-dot-env
MONGO_PORT=27017
MONGO_DB=sagexcadb
MONGODB_URI=mongodb://sagexca:change-me-in-dot-env@127.0.0.1:27017/sagexcadb?authSource=admin

# Certificate authority (sagex-certauth). CA_PASSWORD is required at startup.
# First boot generates CA_KEY_DIR/.prv + .pub (sagex-format); later boots load them.
CA_KEY_DIR=./ca-data
CA_PASSWORD=change-me-too
CA_IDENTITY=sagex-ca
CA_VALIDITY_DAYS=365
PERMIT_TTL_HOURS=24
# Pinned peer keys (static by design: verified locally, never synced).
# BLS = chatsrv ML-DSA-65 public key (STANDARD base64, same bytes as its
# MLDSA65_PK_B64) + expected kid; RG = gateway key from its boot log
# (RG public_b64) + gateway id. Missing/malformed pins refuse startup.
CHATSRV_PK_B64=
CHATSRV_KID=sagex-chatsrv-mldsa65-01
RG_PK_B64=
RG_ID=sagex-gateway-01
# Strict mode: CSR requires a chatsrv token (no legacy permit-only path).
REQUIRE_CHATSRV_TOKEN=false

# Ledger explorer UI (sagex-ledger-ui, read-only).# Gateway base URL; auditor permit for the Logs tab (mint with:
# sagex-certauth issue-permit --identity ledger-auditor --ttl-hours 720).
# Leave SAGEX_AUDIT_PERMIT empty and paste it in-app instead if preferred.
SAGEX_GATEWAY_URL=http://127.0.0.1:8081
SAGEX_AUDIT_PERMIT=

# MinIO object storage (docker-compose service `minio`, chat media bucket).
# Bits live in ./minio-data (gitignored). Console on :9001 (ops only).
MINIO_ROOT_USER=sagexminio
MINIO_ROOT_PASSWORD=change-me-minio-too
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=sagex-media
MINIO_ENDPOINT=http://127.0.0.1:9000
MEDIA_MAX_BYTES=26214400
PRESIGN_TTL_SECS=900
