# sagex — root env (single source of truth for compose + Rust server).
# Copy to `.env` and adjust secrets. Real environment variables always win.
HOST=127.0.0.1
PORT=8080

# MongoDB (docker-compose service `mongodb`, database `sagexcadb`)
MONGO_ROOT_USER=sagexca
MONGO_ROOT_PASSWORD=change-me-in-dot-env
MONGO_PORT=27017
MONGO_DB=sagexcadb
MONGODB_URI=mongodb://sagexca:change-me-in-dot-env@127.0.0.1:27017/sagexcadb?authSource=admin

# Certificate authority (sagex-certauth). CA_PASSWORD is required at startup.
# First boot generates CA_KEY_DIR/.prv + .pub (sagex-format); later boots load them.
CA_KEY_DIR=./ca-data
CA_PASSWORD=change-me-too
CA_IDENTITY=sagex-ca
CA_VALIDITY_DAYS=365
PERMIT_TTL_HOURS=24
