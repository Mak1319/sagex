# sagex-chatsrv local config.
# The server reuses the ROOT-level mongodb service (see /docker-compose.yml);
# it just uses its own unique database `chatdbx` (created lazily by Mongo).
# Either export these vars or copy this file to `.env` inside THIS directory
# and run the binary with CWD=crates/sagex-chatsrv. Explicit env always wins.
MONGODB_URI=mongodb://sagexca:change-me-in-dot-env@127.0.0.1:27017/chatdbx?authSource=admin
DB_NAME=chatdbx
BIND_ADDR=0.0.0.0:8080
RUST_LOG=sagex_chatsrv=debug,tower_http=info
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_SECS=2592000
OTP_TTL_SECS=600
OTP_RESEND_COOLDOWN_SECS=60
OTP_MAX_ATTEMPTS=5
MLDSA65_SK_B64=
MLDSA65_PK_B64=
MLDSA65_KID=sagex-chatsrv-mldsa65-01
# Media object storage (MinIO service in root docker-compose.yml).
# Empty MINIO_ENDPOINT = in-memory fake (dev only; text chat unaffected).
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=sagex-media
MINIO_ROOT_USER=sagexminio
MINIO_ROOT_PASSWORD=change-me-minio-too
MEDIA_MAX_BYTES=26214400
PRESIGN_TTL_SECS=900
