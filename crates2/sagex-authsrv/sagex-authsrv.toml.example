# sagex-authsrv example config (non-secret). Secrets go in `.env`, never here.
bind_addr = "127.0.0.1:8470"
ca_cert_pem_path = "ca-cert.pem"
chatsrv_iss = "sagex-chatsrv"
audience = "sagex-authsrv"
# ML-DSA-65 verifying key of sagex-chatsrv, used to verify CSR JWTs.
# Preferred: copy of the chatsrv *.pub file (postcard PublicFileFormatExternal).
# Copy it at provisioning: cp environments/sagex-chatsrv/*.pub <authsrv-env>/chatsrv.pub
chatsrv_pub_path = "chatsrv.pub"
# Fallback inline hex (leave empty when using the file above).
chatsrv_dsa_pubkey_hex = ""
cert_ttl_days = 365
issuer_cn = "sagex-ca-test"
mongodb_db = "sagex_auth"
mongodb_collection = "users"
