# sagex-register-gateway example config. Copy to environments/register-gateway/config.toml
bind_addr = "127.0.0.1:8490"
ledger_nodes = ["http://127.0.0.1:8481", "http://127.0.0.1:8482", "http://127.0.0.1:8483", "http://127.0.0.1:8484"]
trusted_pubs_dir = "trusted-pubs"
ca_cert_pem_path = "ca-cert.pem"
read_open = true
bearer_token_env = "GATEWAY_BEARER"
# Extra accepted login keys (one per line, `#` comments), e.g. desktop
# telemetry app keys generated via sagex-telemetry. Lives in the env dir.
bearer_tokens_file = "telemetry-bearers.txt"
