# --- server ---
PORT=3001
NODE_ENV=development
# --- mongo ---
MONGODB_URI=mongodb://chatroot:chatsecret@localhost:27017/chatdb?authSource=admin
# --- auth (opaque tokens, no JWT) ---
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
DEVICE_TOKEN_TTL_DAYS=90
# --- security ---
CORS_ORIGIN=http://localhost:3000
# --- limits ---
JSON_LIMIT=1mb
MSG_CIPHERTEXT_MAX_BYTES=262144
BACKUP_BLOB_MAX_BYTES=52428800
